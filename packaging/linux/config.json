{
  "host": "0.0.0.0",
  "port": 8080,
  "storage_root": "/var/lib/crowleys_cloud/storage",
  "db_path": "/var/lib/crowleys_cloud/data/server.sqlite3",
  "temp_upload_dir": "/var/lib/crowleys_cloud/uploads",
  "public_dir": "/usr/share/crowleys_cloud/public",
  "jwt_secret": "",
  "upload_limit_bytes": 10737418240,
  "rate_limit_per_minute": 10,
