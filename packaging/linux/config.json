  "refresh_token_ttl_seconds": 7776000,
  "log_dir": "/var/log/crowleys_cloud",
  "log_level": "INFO",
  "access_log_enabled": true,
  "video_thumbs_enabled": true,
  "ffmpeg_binary": "ffmpeg",
  "log_retention_days": 30,
  "hash_files": true,
  "encryption_key": "",
  "trash_retention_days": 7
}
