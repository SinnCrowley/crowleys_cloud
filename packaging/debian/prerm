#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl --quiet stop crowleys-cloud-server.service || true
            systemctl --quiet disable crowleys-cloud-server.service || true
        fi
    ;;
esac

exit 0
